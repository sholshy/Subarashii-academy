# Subarashii Smart Showcase - Environment Variables
DEBUG=True
SECRET_KEY=subarashii_smart_showcase_insecure_dev_key_2026_change_in_prod
ALLOWED_HOSTS=localhost,127.0.0.1,subarashii.cl,*.subarashii.cl

# Database (PostgreSQL 17 for production/docker, falls back to SQLite for local tests if DB_HOST is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=subarashii_showcase
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Integrations
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7/
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TUU_API_KEY=
TUU_API_SECRET=
TUU_WEBHOOK_SECRET=
TUU_API_URL=https://api.tuu.cl/v1/

# QR Code
SHOWCASE_BASE_URL=https://subarashii.cl/v/
ACADEMY_BASE_URL=https://subarashii.cl/academy/
