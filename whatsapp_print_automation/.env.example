# Copia este archivo como .env y ajusta los valores.

WHATSAPP_URL=https://web.whatsapp.com/
POLL_INTERVAL_SECONDS=8
HEADLESS=false

# Carpetas relativas al proyecto, salvo que uses rutas absolutas.
PENDING_DIR=pendientes
PRINTED_DIR=impresos
ERROR_DIR=errores
LOG_DIR=logs
SESSION_DIR=session
STATE_DB=data/state.sqlite3

# SumatraPDF. Ajusta esta ruta segun tu instalacion.
SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe

# Nombres exactos de impresoras instaladas en Windows.
LASER_PRINTER_NAME=Laser
COLOR_PRINTER_NAME=Color

# Extensiones permitidas, separadas por coma.
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# Limites de seguridad.
PRINT_TIMEOUT_SECONDS=120
DOWNLOAD_TIMEOUT_SECONDS=60000

# Muestra informacion de diagnostico cuando un chat no tiene adjuntos detectados.
DEBUG_WHATSAPP_SCAN=true

# Minutos durante los que una frase de impresion queda activa esperando adjuntos.
PRINT_INTENT_WINDOW_MINUTES=10
