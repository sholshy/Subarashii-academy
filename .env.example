# =========================================================================
# VARIABLES DE ENTORNO - SUBARASHII ACADEMY / DUELORAPIDO.CL
# =========================================================================

# Clave secreta para cookies de sesión Flask (cambiar por una cadena aleatoria y larga)
SECRET_KEY=cambiar_por_clave_secreta_super_segura_de_produccion_2026

# Token de autenticación de API para que la app de escritorio del Organizador
# pueda comunicarse de forma segura con el servidor hosting externo.
# Debe coincidir con la clave que pongas en la app de escritorio en "Hosting Cloud".
ORGANIZER_API_KEY=subarashii_secret_organizer_key_2026

# Contraseña maestra para ingresar al panel web del organizador en /organizer/login
ORGANIZER_ADMIN_PASSWORD=subarashii2026

# Ruta a la base de datos SQLite persistente (opcional).
# En hosting con volúmenes montados (ej. Docker, Render Disks, Railway Volume) usa:
# DATABASE_PATH=/data/ygo_data.db
# Si se deja vacío, se usará la carpeta local o AppData.
DATABASE_PATH=

# Puerto de escucha del servidor web (asignado automáticamente por Render / Railway / Heroku)
PORT=8000
